<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.abhishek</groupId>
  <artifactId>SimpleCucumberProject</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <name>SimpleCucumberProject</name>
  <description>A simple Cucumber BDD learning project</description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Use 'release' instead of separate source/target for JDK 21 cross-compilation safety -->
    <maven.compiler.release>21</maven.compiler.release>
    <java.version>21</java.version>
    <!-- Centralise Cucumber version so all io.cucumber artifacts stay in sync -->
    <cucumber.version>7.15.0</cucumber.version>
  </properties>

  <dependencies>

    <!-- JUnit 4 – provides @RunWith used by the Cucumber runner.
         4.13.2 fixes CVE-2020-15250 present in 4.12. -->
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>4.13.2</version>
      <scope>test</scope>
    </dependency>

    <!-- Integrates Cucumber with JUnit 4 so 'mvn test' can run feature files -->
    <dependency>
      <groupId>io.cucumber</groupId>
      <artifactId>cucumber-junit</artifactId>
      <version>${cucumber.version}</version>
      <scope>test</scope>
    </dependency>

    <!-- Core Cucumber library – provides @Given / @When / @Then annotations -->
    <dependency>
      <groupId>io.cucumber</groupId>
      <artifactId>cucumber-java</artifactId>
      <version>${cucumber.version}</version>
      <scope>test</scope>
    </dependency>

    <!-- PicoContainer enables constructor-injection between step-definition classes.
         Useful when sharing state across multiple step files without static fields. -->
    <dependency>
      <groupId>io.cucumber</groupId>
      <artifactId>cucumber-picocontainer</artifactId>
      <version>${cucumber.version}</version>
      <scope>test</scope>
    </dependency>

    <!-- JSON parsing – used in step definitions to handle client_payload from GitHub -->
    <dependency>
      <groupId>org.json</groupId>
      <artifactId>json</artifactId>
      <version>20240303</version>
    </dependency>

  </dependencies>

  <build>
    <plugins>

      <!-- Compiler plugin – explicitly targets JDK 21 release -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <release>21</release>
        </configuration>
      </plugin>

      <!-- Surefire runs JUnit tests during the 'test' lifecycle phase.
           The TestRunner class name doesn't match the default patterns
           (*Test, Test*) so we explicitly include it here.
           You can also override per-run with: mvn test -Dtest=TestRunner -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
        <configuration>
          <includes>
            <include>**/TestRunner.java</include>
          </includes>
        </configuration>
      </plugin>

    </plugins>
  </build>

</project>